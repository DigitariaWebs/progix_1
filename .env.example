# Copy to .env.local and fill in. The contact API needs CONTACT_EMAIL plus
# EITHER a Resend API key OR full SMTP credentials.

# Recipient of contact-form submissions
CONTACT_EMAIL=contact@progix.pro

# Option A — Resend (https://resend.com, domain must be verified)
RESEND_API_KEY=
SMTP_FROM=no-reply@progix.pro

# Option B — SMTP (provider of the contact@progix.pro mailbox, or Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Set to "false" to REOPEN the site. Maintenance is ON by default.
MAINTENANCE_MODE=true

# --- Supabase (public: safe in the browser; RLS is the boundary) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# --- Server-only secret (NEVER prefix NEXT_PUBLIC_) ---
# service_role bypasses RLS — used only in trusted server code (admin devis CRUD).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Password gate for /devis/[client] (per-client access_code in Supabase overrides this default).
NEXT_PUBLIC_SITE_ACCESS_CODE="progix2026"

# Public URL of this deployment. Used by the server-side PDF renderer
# (Puppeteer) to navigate to its own pages. On Vercel this can usually be
# left unset — VERCEL_URL is used as a fallback.
SITE_URL="http://localhost:3000"

# --- OpenAI (server-only; parses the closer's pasted prompt output into a
# structured devis draft on /admin/devis/new). Without it, the "Prompt
# closer" card is disabled but the rest of the form works normally.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=
